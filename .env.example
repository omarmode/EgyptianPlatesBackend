# ==== Supabase ====
# Project API URL (already filled for your project)
SUPABASE_URL=https://cpedlqwpzpvpwydeocbc.supabase.co

# service_role key (SECRET). Get it from:
# Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role
# NEVER expose this key in a mobile/desktop client. Server only.
SUPABASE_SERVICE_ROLE_KEY=paste-your-service_role-key-here

# ==== Super Admin ====
# Legacy shared secret. Sent as the "x-admin-key" header; treated as super-admin.
# Used by the built-in web dashboard at /admin. Use a long random string.
ADMIN_API_KEY=change-me-to-a-long-random-secret

# ==== Role-Based Access Control ====
# The single super-admin email (Google account).
SUPER_ADMIN_EMAIL=omarabdelrahman369@gmail.com
# Optional comma-separated admin (client) emails, in addition to the
# public.admin_users table. Example: client1@gmail.com,client2@company.com
ADMIN_EMAILS=

# ==== Server ====
PORT=3000
